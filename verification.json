{
  "push": [
    {
      "name": "source",
      "browser": false,
      "hosted": false,
      "commands": [
        "pnpm run check --profile first-party",
        "node scripts/contract-docs.mjs check"
      ]
    },
    {
      "name": "typecheck",
      "browser": false,
      "hosted": false,
      "commands": [
        "pnpm run typecheck"
      ]
    },
    {
      "name": "runtime",
      "browser": true,
      "hosted": true,
      "commands": [
        "pnpm run build"
      ]
    },
    {
      "name": "site",
      "browser": true,
      "hosted": false,
      "commands": [
        "node --test tests/site/site.test.mjs"
      ]
    },
    {
      "name": "domain-scheduling",
      "browser": true,
      "hosted": false,
      "commands": [
        "STRAP_RESERVATIONS_PROOF_DIR=./logs/proof/reservations pnpm run test:strap:scheduling"
      ]
    },
    {
      "name": "domain-studio-1",
      "browser": true,
      "hosted": false,
      "commands": [
        "STRAP_RIGHTS_PROOF_DIR=./logs/proof/staff node --test --test-concurrency=1 tests/households.test.mjs tests/integrations.test.mjs tests/leads.test.mjs tests/locations.test.mjs tests/pack-credits.test.mjs tests/plan-changes.test.mjs"
      ]
    },
    {
      "name": "domain-studio-2",
      "browser": true,
      "hosted": false,
      "commands": [
        "STRAP_RIGHTS_PROOF_DIR=./logs/proof/staff node --test --test-concurrency=1 tests/plan-entitlements.test.mjs tests/profiles.test.mjs tests/recognition.test.mjs tests/retail.test.mjs tests/security.test.mjs tests/staff-time.test.mjs tests/strap.test.mjs tests/teaching-pay.test.mjs",
        "node --test tests/demo.test.mjs"
      ]
    },
    {
      "name": "portability",
      "browser": false,
      "hosted": false,
      "commands": [
        "pnpm run test:archive"
      ]
    },
    {
      "name": "reports",
      "browser": true,
      "hosted": false,
      "commands": [
        "pnpm run test:reports",
        "STRAP_PROOF_DIR=logs/proof/tax STRAP_TAX_WIDTHS=1440 node --test tests/tax.test.mjs",
        "STRAP_BILLING_BROWSER=1 STRAP_PROOF_DIR=logs/proof/billing node --test --test-concurrency=1 tests/billing-agreements.test.mjs"
      ]
    }
  ],
  "nightly": []
}
