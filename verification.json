{
  "push": [
    {
      "name": "source",
      "browser": false,
      "hosted": false,
      "commands": [
        "pnpm run check --profile first-party",
        "node src/base/contract-docs.mjs check"
      ]
    },
    {
      "name": "typecheck",
      "browser": false,
      "hosted": false,
      "commands": [
        "pnpm run typecheck"
      ]
    },
    {
      "name": "runtime",
      "browser": true,
      "hosted": true,
      "commands": [
        "pnpm run build"
      ]
    },
    {
      "name": "site",
      "browser": true,
      "hosted": false,
      "commands": [
        "node --test tests/site/site.test.mjs"
      ]
    },
    {
      "name": "domain-scheduling",
      "browser": true,
      "hosted": false,
      "commands": [
        "STRAP_RESERVATIONS_PROOF_DIR=./logs/proof/reservations pnpm run test:strap:scheduling"
      ]
    },
    {
      "name": "domain-studio",
      "browser": true,
      "hosted": false,
      "commands": [
        "STRAP_RIGHTS_PROOF_DIR=./logs/proof/staff pnpm run test:strap:studio",
        "node --test tests/demo.test.mjs"
      ]
    },
    {
      "name": "portability",
      "browser": false,
      "hosted": false,
      "commands": [
        "pnpm run test:archive"
      ]
    },
    {
      "name": "reports",
      "browser": true,
      "hosted": false,
      "commands": [
        "pnpm run test:reports",
        "node --test tests/tax.test.mjs",
        "STRAP_BILLING_BROWSER=1 STRAP_PROOF_DIR=logs/proof/billing node --test --test-concurrency=1 tests/billing-agreements.test.mjs"
      ]
    }
  ],
  "nightly": []
}
