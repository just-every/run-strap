{
  "name": "@studio/strap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.20.0"
  },
  "scripts": {
    "build": "rer build",
    "dev": "rer dev",
    "preview": "rer preview",
    "typecheck": "tsc --build --incremental",
    "verify": "rer verify",
    "setup": "rer setup",
    "deploy": "rer deploy",
    "test:runtime": "rer queue test:runtime -- sh -c \"node tests/runtime.mjs\"",
    "onboard": "node scripts/install.mjs",
    "build:app": "rer queue build:app -- sh -c \"vite build\"",
    "verify:app": "node scripts/verify-app.mjs",
    "reset": "rer reset",
    "export": "rer export",
    "import": "rer import",
    "release": "rer release",
    "doctor": "rer doctor",
    "describe": "rer describe",
    "check": "rer check",
    "deps": "rer install",
    "rer": "rer",
    "test:strap": "node --test --test-concurrency=1 tests/strap.test.mjs tests/pack-credits.test.mjs tests/capacity.test.mjs tests/booking-rules.test.mjs tests/attendance.test.mjs tests/spots.test.mjs tests/checkin.test.mjs tests/closures.test.mjs tests/waitlist.test.mjs tests/desk.test.mjs tests/booking-actions.test.mjs tests/staff-actions.test.mjs tests/reports.test.mjs tests/series.test.mjs tests/teaching-pay.test.mjs tests/recognition.test.mjs tests/leads.test.mjs tests/substitutions.test.mjs tests/plan-changes.test.mjs tests/plan-entitlements.test.mjs tests/demand.test.mjs tests/notices.test.mjs tests/class-reminders.test.mjs tests/profiles.test.mjs tests/integrations.test.mjs tests/reservations.test.mjs tests/studio.test.mjs",
    "test:archive": "node --test --test-concurrency=1 tests/archive.test.mjs tests/staff-actions-archive.test.mjs tests/class-reminders-archive.test.mjs",
    "build:site": "rer build --site"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "fflate": "0.8.3",
    "hono": "4.13.7",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.5",
    "@cloudflare/workers-types": "5.20260908.1",
    "@playwright/test": "1.63.0",
    "@runeditrun/rer": "0.2.63",
    "@types/node": "22.18.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.1",
    "marked": "18.0.14",
    "miniflare": "5.20260907.0-alpha",
    "read-excel-file": "9.3.12",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.129.1"
  },
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "overrides": {
      "sharp": "0.35.5",
      "undici": "7.29.1",
      "source-map-js": "1.2.2"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
