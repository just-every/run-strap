{
  "schema": 1,
  "project": {
    "schema": 1,
    "projectId": "just-every/run-strap",
    "name": "Strap",
    "sourceRepository": "https://github.com/just-every/run-strap",
    "license": "MIT",
    "deployment": {
      "target": "cloudflare-workers",
      "artifactFile": "rer-worker-artifact.json"
    },
    "operations": {
      "setup": "pnpm install --frozen-lockfile && pnpm run deps",
      "build": "pnpm run build",
      "verify": "pnpm run typecheck && pnpm check:deployment-spec && node scripts/edition-authoring/cli.mjs check && node scripts/edition-authoring/cli.mjs verify-base --offline && pnpm exec rer check --profile first-party && pnpm run verify",
      "artifact": "node scripts/delivery/base/cli.mjs artifact --config packaging.json",
      "recovery": "Follow README.md and RUN-LOCALLY.md: stop the owned runtime, export with rer export, restore into a fresh installation of the same revision with rer import, configure private settings and sign in again. Damaged archives and populated destinations are refused."
    },
    "verification": {
      "migrationDirectories": [
        "migrations/core"
      ],
      "guidanceFiles": [
        "AGENTS.md",
        "CONTRACT.md",
        "ACCEPTANCE.md",
        "README.md",
        "OPERATIONS.md"
      ]
    }
  },
  "managed": {
    "workflowRef": "runeditrun/delivery/.github/workflows/trusted-build.yml@34cf6c23b5cb86eff0068049bc39feeb38c8ffa9",
    "artifactFile": "rer-worker-artifact.json",
    "buildProfile": "project",
    "verificationProfiles": [
      "full"
    ]
  },
  "artifact": {
    "specInputs": {
      "publicVariableNames": [
        "AUTH_ORIGIN",
        "AUTH_LOCAL",
        "MAIL_PROVIDER",
        "MAIL_FROM",
        "MAIL_RELAY_URL",
        "MAIL_ACCOUNT_ID",
        "OWNER_EMAIL"
      ],
      "secretNames": [
        "SESSION_SECRET",
        "SETUP_TOKEN",
        "MFA_KEY"
      ],
      "optionalSecretNames": [
        "MAIL_API_KEY"
      ],
      "healthPath": "/health",
      "recovery": "Follow README.md and RUN-LOCALLY.md: stop the owned runtime, export with rer export, restore into a fresh installation of the same revision with rer import, configure private settings and sign in again. Damaged archives and populated destinations are refused.",
      "providerEffects": [
        "email"
      ],
      "surfaces": {
        "app": {
          "path": "/",
          "originVariable": "AUTH_ORIGIN",
          "signIn": {
            "path": "/signin",
            "loginHint": false
          },
          "readiness": [
            {
              "path": "/health",
              "statuses": [
                200
              ]
            }
          ]
        }
      },
      "mail": {
        "providers": [
          "rer",
          "resend",
          "sendgrid",
          "cloudflare"
        ]
      }
    }
  },
  "setup": {
    "manifestFile": "rer-setup.json"
  }
}
